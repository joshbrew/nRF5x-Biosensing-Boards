// bt5340_full: complete carrier overlay; automatically loaded by Zephyr.
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>
/ {
	aliases { bio-led = &led0; ads0 = &ads0; ads1 = &ads1; sensor-i2c = &i2c1; };
};
&led0 { gpios = <&gpio1 6 GPIO_ACTIVE_HIGH>; };
&led1 { gpios = <&gpio0 19 GPIO_ACTIVE_HIGH>; status = "disabled"; };
&led2 { gpios = <&gpio1 5 GPIO_ACTIVE_HIGH>; status = "disabled"; };
&led3 { status = "disabled"; };
&button0 { status = "disabled"; };
&button1 { status = "disabled"; };
&button2 { status = "disabled"; };
&button3 { status = "disabled"; };
&gpio_fwd { status = "disabled"; };
&uart0 { status = "disabled"; };
&uart1 { status = "disabled"; };
&spi4 { status = "disabled"; };
&qspi { status = "disabled"; };
&pwm0 { status = "disabled"; };
&nfct { status = "disabled"; };
&adc { status = "disabled"; };
&i2c0 { status = "disabled"; };
&spi1 { status = "disabled"; };
&spi0 {
	status = "okay";
	compatible = "nordic,nrf-spim";
	pinctrl-0 = <&bio_spi_default>;
	pinctrl-1 = <&bio_spi_sleep>;
	pinctrl-names = "default", "sleep";
	cs-gpios = <&gpio0 22 GPIO_ACTIVE_LOW>;
	ads0: adc@0 {
		compatible = "biosensing,ads131m08";
		reg = <0>;
		spi-max-frequency = <8000000>;
		drdy-gpios = <&gpio0 15 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		reset-gpios = <&gpio0 12 GPIO_ACTIVE_LOW>;
	};
	// Uses cpuapp main.cpp extension mapping, NOT its conflicting overlay CS25.
	ads1: adc@1 {
		compatible = "biosensing,ads131m08";
		reg = <1>;
		spi-max-frequency = <8000000>;
		drdy-gpios = <&gpio0 11 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		reset-gpios = <&gpio0 9 GPIO_ACTIVE_LOW>;
		status = "disabled";
	};
};
&i2c1 {
	status = "okay";
	clock-frequency = <400000>;
	pinctrl-0 = <&bio_i2c_default>;
	pinctrl-1 = <&bio_i2c_sleep>;
	pinctrl-names = "default", "sleep";
	bio_bme: bme280@76 { compatible = "bosch,bme280"; reg = <0x76>; };
};
&pinctrl {
	bio_spi_default: bio_spi_default { group1 { psels = <NRF_PSEL(SPIM_SCK, 0, 23)>, <NRF_PSEL(SPIM_MOSI, 0, 29)>, <NRF_PSEL(SPIM_MISO, 0, 20)>; }; };
	bio_spi_sleep: bio_spi_sleep { group1 { psels = <NRF_PSEL(SPIM_SCK, 0, 23)>, <NRF_PSEL(SPIM_MOSI, 0, 29)>, <NRF_PSEL(SPIM_MISO, 0, 20)>; low-power-enable; }; };
	bio_i2c_default: bio_i2c_default { group1 { psels = <NRF_PSEL(TWIM_SDA, 1, 2)>, <NRF_PSEL(TWIM_SCL, 1, 3)>; }; };
	bio_i2c_sleep: bio_i2c_sleep { group1 { psels = <NRF_PSEL(TWIM_SDA, 1, 2)>, <NRF_PSEL(TWIM_SCL, 1, 3)>; low-power-enable; }; };
};

// Built-in usb wiring.
&zephyr_udc0 {
	status = "okay";
	bio_usb: cdc_acm_uart0 { compatible = "zephyr,cdc-acm-uart"; };
};

// Built-in second-adc wiring.
&spi0 { cs-gpios = <&gpio0 22 GPIO_ACTIVE_LOW>, <&gpio0 30 GPIO_ACTIVE_LOW>; };
&ads1 { status = "okay"; };

// Built-in audio wiring.
// BT5340 only. Preserve the executable overlay pin directions (old comments disagreed).
&i2s0 {
	status = "okay";
	pinctrl-0 = <&bio_i2s_default>;
	pinctrl-names = "default";
	clock-source = "ACLK";
};
&clock { hfclkaudio-frequency = <12288000>; };
&pinctrl {
	bio_i2s_default: bio_i2s_default {
		group1 { psels = <NRF_PSEL(I2S_SCK_M, 1, 11)>, <NRF_PSEL(I2S_LRCK_M, 0, 8)>, <NRF_PSEL(I2S_SDOUT, 1, 14)>; };
	};
};

// Built-in dmic wiring.
&pdm0 {
	status = "okay";
	pinctrl-0 = <&bio_pdm_default>;
	pinctrl-names = "default";
	clock-source = "PCLK32M_HFXO";
};
&pinctrl {
	bio_pdm_default: bio_pdm_default { group1 { psels = <NRF_PSEL(PDM_CLK, 1, 8)>, <NRF_PSEL(PDM_DIN, 0, 13)>; }; };
};

// Built-in aux-uart wiring.
// UART2 -> RP2040, from the original BT40 carrier overlay.
&uart2 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&bio_aux_default>;
	pinctrl-1 = <&bio_aux_sleep>;
	pinctrl-names = "default", "sleep";
};
&pinctrl {
	bio_aux_default: bio_aux_default {
		group1 { psels = <NRF_PSEL(UART_TX, 1, 15)>; };
		group2 { psels = <NRF_PSEL(UART_RX, 1, 13)>; bias-pull-up; };
	};
	bio_aux_sleep: bio_aux_sleep { group1 { psels = <NRF_PSEL(UART_TX, 1, 15)>, <NRF_PSEL(UART_RX, 1, 13)>; low-power-enable; }; };
};
